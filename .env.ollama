# Ollama Configuration (Replace OpenAI with local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./sql_app.db

# Vector DB
CHROMA_PERSIST_DIRECTORY=storage/vector_db

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=storage/documents
STORAGE_DOCUMENTS_PATH=storage/documents
CACHE_DIR=storage/cache

# Frontend
FRONTEND_URL=http://localhost:8501

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# NOTE: No OPENAI_API_KEY needed! Ollama runs locally on http://localhost:11434
# Before starting the app, make sure:
# 1. Ollama is installed from https://ollama.com/download
# 2. Run: ollama pull phi3
# 3. Start Ollama: ollama serve
# 4. Then start the backend: python -m uvicorn main:app --reload

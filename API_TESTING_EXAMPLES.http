"""
API Testing Examples for Advanced RAG Authentication System
Use these examples with cURL, Postman, or Python requests
"""

# =============================================================================
# AUTHENTICATION ENDPOINTS
# =============================================================================

# 1. USER SIGNUP (Register)
# ============================================================================
POST http://localhost:8000/api/v1/auth/signup
Content-Type: application/json

{
  "username": "john_doe",
  "email": "john@example.com",
  "password": "SecurePass123",
  "full_name": "John Doe"
}

# Expected Response (201 Created):
{
  "id": 1,
  "username": "john_doe",
  "email": "john@example.com",
  "full_name": "John Doe",
  "is_active": true,
  "created_at": "2026-01-25T10:30:00"
}

# Errors:
# 400: Username or email already registered
# 422: Weak password or invalid input


# 2. CHECK USERNAME AVAILABILITY
# ============================================================================
POST http://localhost:8000/api/v1/auth/check-username/john_doe
Content-Type: application/json

# Expected Response:
{
  "available": false,
  "username": "john_doe",
  "reason": "Username already taken"
}

# OR if available:
{
  "available": true,
  "username": "jane_doe",
  "reason": null
}


# 3. CHECK EMAIL AVAILABILITY
# ============================================================================
POST http://localhost:8000/api/v1/auth/check-email/john@example.com

# Expected Response:
{
  "available": false,
  "email": "john@example.com",
  "reason": "Email already registered"
}


# 4. USER LOGIN
# ============================================================================
POST http://localhost:8000/api/v1/auth/login
Content-Type: application/x-www-form-urlencoded

username=john_doe&password=SecurePass123

# Expected Response (200 OK):
{
  "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJqb2huX2RvZSIsInVzZXJfaWQiOjEsImV4cCI6MTc1NzU5Njk2MCwidHlwZSI6ImFjY2VzcyJ9.xxx",
  "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJqb2huX2RvZSIsInVzZXJfaWQiOjEsImV4cCI6MTc1NzU5Njk2MCwidHlwZSI6InJlZnJlc2gifQ.yyy",
  "token_type": "bearer",
  "user": {
    "id": 1,
    "username": "john_doe",
    "email": "john@example.com",
    "full_name": "John Doe",
    "is_active": true,
    "created_at": "2026-01-25T10:30:00"
  },
  "expires_in": 604800
}

# Errors:
# 401: Incorrect username or password
# 403: User account is inactive


# 5. GET CURRENT USER PROFILE (Protected)
# ============================================================================
GET http://localhost:8000/api/v1/auth/me
Authorization: Bearer {access_token}

# Expected Response (200 OK):
{
  "id": 1,
  "username": "john_doe",
  "email": "john@example.com",
  "full_name": "John Doe",
  "is_active": true,
  "created_at": "2026-01-25T10:30:00"
}

# Errors:
# 401: Invalid or expired token
# 404: User not found


# 6. VALIDATE TOKEN (Protected)
# ============================================================================
POST http://localhost:8000/api/v1/auth/validate-token
Authorization: Bearer {access_token}

# Expected Response (200 OK):
{
  "valid": true,
  "user_id": 1,
  "username": "john_doe",
  "email": "john@example.com"
}

# Errors:
# 401: Invalid token


# 7. REFRESH ACCESS TOKEN
# ============================================================================
POST http://localhost:8000/api/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
}

# Expected Response (200 OK):
{
  "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new_token...",
  "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
  "token_type": "bearer",
  "user": { user_data },
  "expires_in": 604800
}

# Errors:
# 401: Invalid or expired refresh token


# 8. USER LOGOUT (Protected)
# ============================================================================
POST http://localhost:8000/api/v1/auth/logout
Authorization: Bearer {access_token}

# Expected Response (200 OK):
{
  "message": "Successfully logged out",
  "username": "john_doe",
  "timestamp": "2026-01-25T10:35:00"
}


